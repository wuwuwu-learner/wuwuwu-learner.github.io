---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="联系我" sideBarActiveItemID="contact">
  <section>
    <h1 class="text-3xl font-bold">联系我</h1>
    <p class="mt-5 leading-8">欢迎通过电子邮件交流学术合作、科研项目与机器人相关话题。</p>
    <div class="mt-6 rounded-box border border-base-300 bg-base-100 p-6">
      <div class="text-sm opacity-70">电子邮箱</div>
      <div class="mt-2 text-xl font-semibold select-all">wu_xiangbing@163.com</div>
      <p class="mt-4 text-sm opacity-70">可直接复制上述邮箱地址后发送邮件。</p>
    </div>
  </section>
</BaseLayout>
