---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout title = "项目经历" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-3">项目经历</div>
    <p class="text-lg mb-5">以下项目展示我在仿生机构、空天变体结构、腿足机器人和工程样机验证方面的研究与实践。项目图片将在后续补充。</p>
  </div>

  {projects.map((project) => <ProjectCard project={project} />)}
</BaseLayout>
